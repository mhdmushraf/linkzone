{
  "name": "Order",
  "type": "object",
  "properties": {
    "customer_id": {
      "type": "string"
    },
    "customer_name": {
      "type": "string"
    },
    "conversation_id": {
      "type": "string"
    },
    "salesman_id": {
      "type": "string"
    },
    "items": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "amount": {
      "type": "number"
    },
    "paid_status": {
      "type": "string",
      "enum": [
        "paid",
        "due",
        "partial"
      ],
      "default": "due"
    },
    "delivery_status": {
      "type": "string",
      "enum": [
        "pending",
        "dispatched",
        "delivered"
      ],
      "default": "pending"
    },
    "order_date": {
      "type": "string",
      "format": "date-time"
    },
    "organization_id": {
      "type": "string"
    }
  },
  "required": [
    "customer_id",
    "amount",
    "organization_id"
  ],
  "rls": {
    "read": {
      "data.organization_id": "{{user.data.organization_id}}"
    },
    "create": {
      "data.organization_id": "{{user.data.organization_id}}"
    },
    "update": {
      "data.organization_id": "{{user.data.organization_id}}"
    },
    "delete": {
      "data.organization_id": "{{user.data.organization_id}}"
    }
  }
}