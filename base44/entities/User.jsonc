{
  "name": "User",
  "type": "object",
  "properties": {
    "role": {
      "type": "string",
      "description": "The role of the user in the app",
      "enum": [
        "admin",
        "user"
      ]
    },
    "organization_id": {
      "type": "string"
    },
    "app_role": {
      "type": "string",
      "enum": [
        "owner",
        "manager",
        "sales",
        "viewer"
      ]
    },
    "name": {
      "type": "string"
    },
    "phone": {
      "type": "string"
    }
  },
  "required": [
    "role"
  ],
  "rls": {}
}