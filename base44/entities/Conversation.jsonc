{
  "name": "Conversation",
  "type": "object",
  "properties": {
    "customer_id": {
      "type": "string"
    },
    "customer_name": {
      "type": "string"
    },
    "salesman_id": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "archived"
      ],
      "default": "active"
    },
    "last_message_at": {
      "type": "string",
      "format": "date-time"
    },
    "last_message": {
      "type": "string"
    },
    "unread_count": {
      "type": "number",
      "default": 0
    },
    "organization_id": {
      "type": "string"
    }
  },
  "required": [
    "customer_id",
    "organization_id"
  ],
  "rls": {
    "read": {
      "data.organization_id": "{{user.data.organization_id}}"
    },
    "create": {
      "data.organization_id": "{{user.data.organization_id}}"
    },
    "update": {
      "data.organization_id": "{{user.data.organization_id}}"
    },
    "delete": {
      "data.organization_id": "{{user.data.organization_id}}"
    }
  }
}