{
  "name": "Customer",
  "type": "object",
  "properties": {
    "business_name": {
      "type": "string"
    },
    "contact_name": {
      "type": "string"
    },
    "phone": {
      "type": "string"
    },
    "whatsapp_number": {
      "type": "string"
    },
    "address": {
      "type": "string"
    },
    "area": {
      "type": "string"
    },
    "route_id": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "to_reorder",
        "new",
        "win_back"
      ],
      "default": "new"
    },
    "assigned_to": {
      "type": "string"
    },
    "industry": {
      "type": "string"
    },
    "last_order_date": {
      "type": "string",
      "format": "date-time"
    },
    "source": {
      "type": "string",
      "enum": [
        "lead_finder",
        "imported",
        "manual"
      ],
      "default": "manual"
    },
    "organization_id": {
      "type": "string"
    }
  },
  "required": [
    "business_name",
    "organization_id"
  ],
  "rls": {
    "read": {
      "data.organization_id": "{{user.data.organization_id}}"
    },
    "create": {
      "data.organization_id": "{{user.data.organization_id}}"
    },
    "update": {
      "data.organization_id": "{{user.data.organization_id}}"
    },
    "delete": {
      "data.organization_id": "{{user.data.organization_id}}"
    }
  }
}