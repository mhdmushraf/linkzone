{
  "name": "Message",
  "type": "object",
  "properties": {
    "conversation_id": {
      "type": "string"
    },
    "sender": {
      "type": "string",
      "enum": [
        "customer",
        "salesman",
        "system"
      ]
    },
    "content": {
      "type": "string"
    },
    "message_type": {
      "type": "string",
      "enum": [
        "text",
        "product",
        "order",
        "image"
      ],
      "default": "text"
    },
    "product_data": {
      "type": "object"
    },
    "organization_id": {
      "type": "string"
    }
  },
  "required": [
    "conversation_id",
    "sender",
    "organization_id"
  ],
  "rls": {
    "read": {
      "data.organization_id": "{{user.data.organization_id}}"
    },
    "create": {
      "data.organization_id": "{{user.data.organization_id}}"
    },
    "update": {
      "data.organization_id": "{{user.data.organization_id}}"
    },
    "delete": {
      "data.organization_id": "{{user.data.organization_id}}"
    }
  }
}