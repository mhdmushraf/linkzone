{
  "name": "Subscription",
  "type": "object",
  "properties": {
    "organization_id": {
      "type": "string"
    },
    "plan": {
      "type": "string",
      "enum": [
        "starter",
        "growth",
        "enterprise"
      ],
      "default": "starter"
    },
    "status": {
      "type": "string",
      "enum": [
        "trial",
        "active",
        "past_due",
        "cancelled",
        "read_only"
      ],
      "default": "trial"
    },
    "trial_start": {
      "type": "string",
      "format": "date-time"
    },
    "trial_end": {
      "type": "string",
      "format": "date-time"
    },
    "amount": {
      "type": "number"
    },
    "seats": {
      "type": "number",
      "default": 3
    },
    "billing_cycle": {
      "type": "string",
      "enum": [
        "monthly",
        "annual"
      ],
      "default": "monthly"
    },
    "setup_fee": {
      "type": "number",
      "default": 1500
    },
    "setup_fee_paid": {
      "type": "boolean",
      "default": false
    },
    "min_term_end": {
      "type": "string",
      "format": "date-time"
    },
    "lead_limit_monthly": {
      "type": "number"
    },
    "lead_pulls_used": {
      "type": "number",
      "default": 0
    },
    "lead_pulls_month": {
      "type": "string"
    },
    "lead_pulls_trial_used": {
      "type": "number",
      "default": 0
    },
    "whatsapp_sends_used": {
      "type": "number",
      "default": 0
    },
    "whatsapp_sends_month": {
      "type": "string"
    },
    "cancelled_date": {
      "type": "string",
      "format": "date-time"
    },
    "read_only_until": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "organization_id",
    "plan"
  ],
  "rls": {
    "read": {
      "data.organization_id": "{{user.data.organization_id}}"
    },
    "create": {
      "data.organization_id": "{{user.data.organization_id}}"
    },
    "update": {
      "data.organization_id": "{{user.data.organization_id}}"
    },
    "delete": {
      "data.organization_id": "{{user.data.organization_id}}"
    }
  }
}